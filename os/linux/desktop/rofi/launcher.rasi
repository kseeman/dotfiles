/* Launcher theme.
 *
 * Passed with -theme from the SUPER+R binding. rofi reads ~/.config/rofi/
 * config.rasi when it exists and falls back to its built-in defaults when it
 * does not -- there is no such file here, so nothing of HyDE's was ever being
 * used and nothing breaks when HyDE goes.
 *
 * Colours are the `*` block below and nowhere else, which is the arrangement
 * every consumer in this desktop gets: hyprlock has one, wlogout has one, and
 * lib/palette.lua is the Lua equivalent. rofi cannot read Lua, so the values
 * are mirrored in the block P6 will generate. */

* {
    root:     #120D1D;
    base:     #1F1829;
    raised:   #322948;
    overlay:  #453852;
    muted:    #595162;
    accent:   #6E5E8C;
    fg:       #B5B0B1;
    fg-dim:   #8F7D86;

    background-color: transparent;
    text-color:       @fg;

    font: "CaskaydiaCove Nerd Font 12";
}

window {
    /* Centred and fixed width rather than full-screen: a launcher that covers
     * a 5120px ultrawide puts the list a long way from where the eye is. */
    width:            640px;
    location:         center;
    anchor:           center;

    background-color: @base;
    border:           2px;
    border-color:     @raised;
    border-radius:    12px;
    padding:          16px;
}

inputbar {
    spacing:          10px;
    padding:          10px 14px;
    margin:           0 0 12px 0;

    background-color: @root;
    border-radius:    8px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder:            "Search";
    placeholder-color:      @fg-dim;
    cursor:                 text;
}

listview {
    lines:         8;
    scrollbar:     false;
    fixed-height:  false;
    spacing:       2px;
}

element {
    padding:       9px 12px;
    border-radius: 8px;
    cursor:        pointer;
}

element normal normal {
    text-color: @fg;
}

/* An entry that is already running. Dimmed rather than hidden: knowing a window
 * exists is the difference between switching to it and opening a second one. */
element normal active {
    text-color: @fg-dim;
}

element selected {
    background-color: @accent;
    text-color:       @root;
}

element-icon {
    size:   22px;
    margin: 0 10px 0 0;
}

element-text {
    vertical-align: 0.5;
    text-color:     inherit;
}

message {
    padding:          10px;
    border-radius:    8px;
    background-color: @overlay;
}
