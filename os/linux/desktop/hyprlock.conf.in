# Lock screen for the Lua desktop session.
#
# Its own file rather than ~/.config/hypr/hyprlock.conf, which HyDE owns and
# which is unportable on purpose: it sources HyDE state, pulls colours from
# wallbash variables, and fills labels from `hyde-shell` commands. None of that
# survives HyDE's removal, and a lock screen built from a missing config is the
# one failure that needs a TTY to escape. hyprlock is started with -c pointing
# here, from both the keybinding and hypridle.
#
# Deliberately plain: a background, a clock, and somewhere to type. Everything
# HyDE's version adds -- now-playing, weather, a greeting, a profile image --
# is a reason for this file to break later.

# -----------------------------------------------------------------------------
# Colours
# -----------------------------------------------------------------------------

# Generated from lib/palette.lua by render-theme.lua. hyprlock reads hyprlang
# rather than Lua, so the values cannot be required -- they are substituted into
# this one block instead, which is why no colour appears below this point except
# by name.
#
# The ":bare" form strips the leading # from a palette value, because hyprlang
# wants rgba(RRGGBBAA) rather than CSS hex. The alpha stays in the template: it
# is a property of this file, not of the palette.
#
# Substitution applies to comments too, so a comment cannot spell a token out
# literally -- it would be replaced, or fail the render if the name is not real.
$root = rgba(@root:bare@FF)
$base = rgba(@base:bare@FF)
$overlay = rgba(@overlay:bare@FF)
$muted = rgba(@muted:bare@FF)
$accent = rgba(@accent:bare@FF)
$fg = rgba(@fg:bare@FF)
$fg_dim = rgba(@fg_dim:bare@FF)

general {
    hide_cursor = true

    # Enter on an empty field does nothing rather than counting as a failed
    # attempt, which on a machine that locks itself is the difference between
    # waking it and being told to wait.
    ignore_empty_input = true
}

background {
    monitor =
    color = $root

    # A flat colour, not the session behind it. hyprlock gathers screencopy
    # frames at startup regardless of this -- the log shows two dma frames
    # captured before the lock appears -- but with no path set, nothing is
    # drawn from them, so the screen is this colour and the labels below.
}

# The time, large, above the input.
label {
    monitor =
    text = cmd[update:1000] date +"%H:%M"
    color = $fg
    font_size = 96
    font_family = CaskaydiaCove Nerd Font
    position = 0, 160
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:60000] date +"%A, %-d %B"
    color = $fg_dim
    font_size = 20
    font_family = CaskaydiaCove Nerd Font
    position = 0, 80
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 320, 52
    outline_thickness = 2

    outer_color = $muted
    inner_color = $base
    font_color = $fg
    check_color = $accent
    fail_color = $accent

    # Nothing about the number of characters typed is worth leaking to someone
    # standing behind you.
    dots_size = 0.25
    dots_spacing = 0.3
    dots_center = true
    hide_input = false

    placeholder_text = <i>$USER</i>
    fail_text = <i>$FAIL</i>

    position = 0, -40
    halign = center
    valign = center
}
