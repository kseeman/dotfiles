ForegroundInactive=@fg_dim:rgb@
ForegroundActive=@fg_bright:rgb@
ForegroundLink=@accent:rgb@
ForegroundVisited=@accent_deep:rgb@
ForegroundNegative=218,68,83
ForegroundNeutral=246,116,0
