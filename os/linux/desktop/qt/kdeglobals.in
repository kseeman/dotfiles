[General]
ColorScheme=rice
AccentColor=@accent:rgb@

[UiSettings]
# KDE reads the scheme name from here as well as [General]; leaving the old
# one behind was enough to keep the previous colours on some applications.
ColorScheme=rice

[Icons]
Theme=@icon_theme@

[KDE]
widgetStyle=kvantum
