/* Styling for the logout menu.
 *
 * Colours are generated from lib/palette.lua by render-theme.lua. wlogout reads
 * CSS and cannot require Lua, so they are substituted into the define-color
 * block below, which is why no colour appears past it except by name.
 *
 * Text rather than icons on purpose: icon buttons mean shipping or depending on
 * an icon set, and this menu has five buttons that each say what they do. */

@define-color root   @root@;
@define-color base   @base@;
@define-color raised @raised@;
@define-color accent @accent@;
@define-color fg     @fg@;

window {
    /* Not opaque: the session stays visible behind the menu, which is what
     * makes it read as a dialog over the desktop rather than a new screen. */
    background-color: alpha(@root, 0.85);
}

button {
    background-color: @base;
    color: @fg;
    border: 2px solid @raised;
    border-radius: 10px;

    font-family: "CaskaydiaCove Nerd Font";
    font-size: 16px;

    margin: 8px;
    background-repeat: no-repeat;
    background-position: center;
}

button:hover,
button:focus {
    background-color: @raised;
    border-color: @accent;
    color: @fg;
}

/* Shutdown is the one that loses unsaved work without asking, so it is the one
 * that does not look like the others when the pointer is on it. */
#shutdown:hover,
#shutdown:focus {
    border-color: @accent;
    background-color: @accent;
    color: @root;
}
