${XDG_CONFIG_HOME:-$HOME/.config}/tmux/wallbash.conf|tmux list-sessions &>/dev/null && tmux source-file "${XDG_CONFIG_HOME:-$HOME/.config}/tmux/wallbash.conf" >/dev/null 2>&1; true
# -----------------------------------------------------------------------------
# tmux colours — generated by HyDE wallbash. Do not edit.
# -----------------------------------------------------------------------------
#
# Source template: os/linux/wallbash/tmux.dcol in the dotfiles repo.
# Regenerated on every theme, wallpaper and mode change, then re-sourced into a
# running tmux server by the command on the template's header line.
#
# Only styles are set here. Layout and formats stay in tmux.conf, so the two can
# change independently.
#
# Palette: pry1-4 are primaries, txt1-4 the matching text colours, and NxaM the
# nine accents belonging to primary N.

# Status bar: primary background with its matching text colour.
set -g status-style "bg=#<wallbash_pry1>,fg=#<wallbash_txt1>"

# Session name on the left, given an accent so it reads as a label.
set -g status-left-style "bg=#<wallbash_1xa4>,fg=#<wallbash_txt1>,bold"
set -g status-right-style "bg=#<wallbash_pry1>,fg=#<wallbash_txt1>"

# Inactive windows recede; the active one takes a brighter accent.
setw -g window-status-style "bg=#<wallbash_pry1>,fg=#<wallbash_txt1>"
setw -g window-status-current-style "bg=#<wallbash_1xa6>,fg=#<wallbash_txt1>,bold"
setw -g window-status-activity-style "bg=#<wallbash_pry1>,fg=#<wallbash_1xa9>"

# Pane borders: the active one is the clearest signal of focus, so it gets the
# strongest accent while inactive borders stay close to the background.
set -g pane-border-style "fg=#<wallbash_1xa2>"
set -g pane-active-border-style "fg=#<wallbash_1xa6>"

# Command prompt and messages.
set -g message-style "bg=#<wallbash_pry2>,fg=#<wallbash_txt2>,bold"
set -g message-command-style "bg=#<wallbash_pry2>,fg=#<wallbash_txt2>"

# Copy-mode selection and search highlighting.
set -g mode-style "bg=#<wallbash_1xa4>,fg=#<wallbash_txt1>"

# Dim the inactive pane slightly so the focused one stands out.
set -g window-style "fg=#<wallbash_txt1>"
set -g window-active-style "fg=#<wallbash_txt1>"
