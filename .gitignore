.DS_STORE
# Superseded by ~/.userconfig/nvim/local.lua; kept so a stale copy on some
# machine can never be committed.
nvim/lua/local-commands.lua

# Claude Code: local-only config must never land in this public repo
claude/**/*.local.*
claude/settings.local.json
claude/**/.credentials.json

# Written by Claude Code through the ~/.claude/skills symlink: account-synced
# skills, named after account/org IDs. Never ours to track.
claude/skills/synced/

# Session worktrees created by Claude Code inside the repo
.claude/worktrees/
